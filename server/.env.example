# ==========================================
# VAAGAI E-COMMERCE BACKEND CONFIGURATION
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# ------------------------------------------
# PostgreSQL Database Connection Options
# ------------------------------------------
# Option 1: Full Connection String (Recommended for Supabase, Neon, Render, Railway)
# e.g., postgresql://username:password@ep-cool-flower.us-east-2.aws.neon.tech/neondb?sslmode=require
# or: postgresql://postgres:postgres@localhost:5432/vaagai_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vaagai_db

# Option 2: Individual Connection Parameters (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=vaagai_db
# Set to 'true' if connecting to a cloud provider like Neon or Supabase requiring SSL
PGSSL=false

# ------------------------------------------
# JWT Authentication Secret
# ------------------------------------------
JWT_SECRET=vaagai_super_secret_jwt_key_2026_artisanal_sarees_heritage
JWT_EXPIRES_IN=7d

# ------------------------------------------
# Admin Default Account (Created during db:seed)
# ------------------------------------------
ADMIN_NAME=Vaagai Curator
ADMIN_EMAIL=admin@vaagai.com
ADMIN_PASSWORD=Admin@Vaagai2026!
